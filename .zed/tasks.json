[
  {
    "label": "门禁：ruff check",
    "command": "uvx",
    "args": ["ruff", "check", "."],
    "env": {},
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never",
    "shell": "system",
    "show_summary": true,
    "show_command": true,
    "save": "all"
  },
  {
    "label": "门禁：ty check",
    "command": "uvx",
